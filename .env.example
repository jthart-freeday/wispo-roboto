# Local Development Configuration
# Copy this file to .env and fill in your values

# Use local secrets instead of GCP Secret Manager
USE_LOCAL_SECRETS=true

# Telegram Bot API Key (get from @BotFather on Telegram)
TELEGRAM_API_KEY=your-telegram-bot-api-key-here

# Skaping API Key (optional, for mountain images)
SKAPING_API_KEY=your-skaping-api-key-here

# LinkedIn Access Token (for post statistics via /linkedin command)
# Get one at https://www.linkedin.com/developers/apps
# Required scopes: r_liteprofile, r_member_social (or w_member_social)
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token-here
